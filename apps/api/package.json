{
  "name": "@crewnest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node ../../tools/copy-api-migrations.mjs",
    "start": "node dist/apps/api/src/main.js",
    "migrate": "tsx src/migrate.ts",
    "owner": "tsx src/owner.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  }
}
