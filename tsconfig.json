{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"]
  },
  "include": ["apps/desktop/src", "apps/web/src", "apps/web/vite.config.ts", "apps/api/src", "apps/desktop/vite.config.ts", "packages/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
